{
  // This is a Cloudflare PAGES project (git-connected, serving egyptprice.com), so this
  // config uses the Pages flavour: pages_build_output_dir marks it as such, functions/
  // is picked up by file-based routing, and the KV binding below is applied to the
  // project at build time.
  //
  // An earlier revision used the Workers flavour (main + assets). Pages builds silently
  // ignore that, which shipped the frontend without its API: the rating widget rendered,
  // POST /api/feedback hit the bare asset layer, and every tap failed with a 405.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "egypt-price-check",
  "compatibility_date": "2026-07-01",
  "pages_build_output_dir": "./out",

  "kv_namespaces": [
    { "binding": "FEEDBACK", "id": "4b8ce0e23e494d72978d174663815118" }
  ]
}
